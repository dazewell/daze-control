{
  "permissions": {
    "allow": [
      "PowerShell(pwsh scripts/pr-merge.ps1:*)",
      "Bash(pwsh scripts/pr-merge.ps1:*)",
      "PowerShell(pwsh -File scripts/pr-merge.ps1:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/print-resume.ps1\""
          }
        ]
      }
    ]
  }
}
