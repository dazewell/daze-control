<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="CtrlAltDaze.Editor.BackupCard.RestoreDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CtrlAltDaze.Editor.ViewModels.BackupCard">

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="460">
        <StackPanel Spacing="12" Margin="0,0,16,0">
            <TextBlock Text="{x:Bind ViewModel.Origin}" Style="{StaticResource SettingsCardDescription}" />

            <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Title="This backup can't be restored"
                     Message="{x:Bind ViewModel.Unreadable}" Visibility="{x:Bind ViewModel.IsUnreadable}" />

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanChooseMode}">
                <TextBlock Text="What will change" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Summary, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.CanChooseMode}">
                <TextBlock Text="How to restore" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <RadioButton x:Name="ReplaceRadio" GroupName="RestoreMode" Content="Replace everything (recommended)"
                             IsEnabled="{x:Bind ViewModel.CanReplace}" IsChecked="{x:Bind ViewModel.ReplaceSelected, Mode=TwoWay}" />
                <TextBlock Text="Your PC ends up exactly like the backup. Anything only on this PC is removed."
                           Style="{StaticResource SettingsCardDescription}" Margin="28,-4,0,4" />
                <RadioButton GroupName="RestoreMode" Content="Add what's missing"
                             IsEnabled="{x:Bind ViewModel.CanAddMissing}" IsChecked="{x:Bind ViewModel.AddMissingSelected, Mode=TwoWay}" />
                <TextBlock Text="{x:Bind ViewModel.AddMissingHelp}" Style="{StaticResource SettingsCardDescription}" Margin="28,-4,0,0" />
            </StackPanel>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}" TabFocusNavigation="Local"
                          Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RestoreItemRow">
                        <Grid ColumnSpacing="12" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource SettingsCardDescription}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind State}" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasNeedsAttention}">
                <TextBlock Text="Needs attention" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.NeedsAttention}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <InfoBar Severity="Warning" IsOpen="True" IsClosable="False" Title="Looks like a secret" Visibility="{x:Bind ViewModel.HasWarnings}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Warnings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Text="{x:Bind}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </InfoBar>

        </StackPanel>
    </ScrollViewer>
</UserControl>
