<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CtrlAltDaze</AssemblyName>
    <AssemblyTitle>Ctrl Alt Daze</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Resident engine: Native AOT, no UI framework (D-001). -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- No background GC thread; the engine allocates almost nothing at idle (budget, CLAUDE.md). -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- NOTIFYICONDATAW's layout is per-architecture; the engine is win-x64 only. -->
    <CsWin32PlatformTarget>x64</CsWin32PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CtrlAltDaze.Core\CtrlAltDaze.Core.csproj" />
    <ProjectReference Include="..\CtrlAltDaze.Runtime\CtrlAltDaze.Runtime.csproj" />
    <ProjectReference Include="..\CtrlAltDaze.Providers\CtrlAltDaze.Providers.csproj" />
    <ProjectReference Include="..\CtrlAltDaze.Ipc\CtrlAltDaze.Ipc.csproj" />
  </ItemGroup>

</Project>
