<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DazeControl.Editor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Cards modelled on Windows Settings, ported from the OSD's SettingsWindow (OSD D-010):
                 icon, header + description, control on the right. -->
            <Style x:Key="SettingsCard" TargetType="Grid">
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="ColumnSpacing" Value="16" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>
            <Style x:Key="SettingsCardIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsCardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SettingsSection" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,24,0,4" />
            </Style>
            <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!-- One button size for the whole editor (D-121, UX.md "Buttons"): every button is at least ControlHeight tall, so
                 text, icon + text and icon-only buttons side by side line up. Never set Height/Width/Padding on a button: pick a style. -->
            <x:Double x:Key="ControlHeight">32</x:Double>
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
            </Style>
            <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
            </Style>
            <!-- No DropDownButton style on purpose: any Style based on DefaultDropDownButtonStyle crashes the editor at start
                 (X-013); the stock one is already as tall as the rest. -->
            <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
                <Setter Property="Padding" Value="0,4" />
            </Style>
            <!-- Primary action: accent-filled. -->
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
            </Style>
            <!-- Text-only action that looks like a link but opens a flyout (HyperlinkButton has no Flyout). -->
            <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource TextBlockButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
                <Setter Property="Padding" Value="0,4" />
            </Style>
            <!-- Icon-only: a square the size of every other button. Needs AutomationProperties.Name and a tooltip. -->
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="{StaticResource ControlHeight}" />
                <Setter Property="Height" Value="{StaticResource ControlHeight}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- Icon-only without a frame (remove ×, chevrons, "more" menus inside rows). -->
            <Style x:Key="SubtleIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="IconToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="Width" Value="{StaticResource ControlHeight}" />
                <Setter Property="Height" Value="{StaticResource ControlHeight}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- Narrow chips in a fixed grid (weekdays): same height, tighter sides. -->
            <Style x:Key="ChipToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="4,0" />
            </Style>
            <!-- The two round handles on a selected connection in the canvas: smaller on purpose, a canvas affordance. -->
            <Style x:Key="CanvasHandleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
