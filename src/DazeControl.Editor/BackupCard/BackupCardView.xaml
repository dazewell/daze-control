<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DazeControl.Editor.BackupCard.BackupCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:motion="using:DazeControl.Editor"
    xmlns:vm="using:DazeControl.Editor.ViewModels.BackupCard"
    HorizontalContentAlignment="Stretch">

    <StackPanel Spacing="4" motion:Motion.Animate="True">
        <TextBlock Text="Backup and restore" Style="{StaticResource SettingsSection}" />

        <InfoBar x:Name="MessageBar" IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}" Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                 IsClosable="True" Closed="OnMessageClosed" AutomationProperties.LiveSetting="Polite" />

        <Grid Style="{StaticResource SettingsCard}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE74E;" Style="{StaticResource SettingsCardIcon}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Back up" />
                <TextBlock Text="Save your flows, library and settings in one file." Style="{StaticResource SettingsCardDescription}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Back up now" Click="OnBackUpNow" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="DropCard" Style="{StaticResource SettingsCard}" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE8B5;" Style="{StaticResource SettingsCardIcon}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Restore" />
                <TextBlock Text="Choose a backup file, or drop one here. You see what changes first." Style="{StaticResource SettingsCardDescription}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Restore from file" Click="OnRestoreFromFile" VerticalAlignment="Center" />
        </Grid>

        <Grid Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.CanUndo, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7A7;" Style="{StaticResource SettingsCardIcon}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Last restore" />
                <TextBlock Text="Put back what was here before. Available until you close the editor." Style="{StaticResource SettingsCardDescription}" />
            </StackPanel>
            <Button Grid.Column="2" Content="Undo restore" Click="OnUndo" VerticalAlignment="Center" />
        </Grid>

        <TextBlock Text="Recent backups" Style="{StaticResource SettingsSection}" />
        <TextBlock Text="{x:Bind ViewModel.AutomaticText, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" Margin="1,0,0,4" />
        <ItemsControl ItemsSource="{x:Bind ViewModel.Backups}" TabFocusNavigation="Local" motion:Motion.AnimateItems="True">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:BackupRowViewModel">
                    <Grid Style="{StaticResource SettingsCard}" AutomationProperties.Name="{x:Bind Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" />
                            <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Restore" Tag="{x:Bind}" Click="OnRestoreRow" IsEnabled="{x:Bind IsReadable}" />
                            <Button Tag="{x:Bind}" Click="OnDeleteRow" AutomationProperties.Name="Delete backup" ToolTipService.ToolTip="Delete backup">
                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Visibility="{x:Bind ViewModel.HasEarlierSaves, Mode=OneWay}" Spacing="4">
            <TextBlock Text="Earlier saves" Style="{StaticResource SettingsSection}" />
            <TextBlock Text="Saved the first time you change something after the editor opens. They hold flows and settings only." Style="{StaticResource SettingsCardDescription}" Margin="1,0,0,4" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.EarlierSaves}" TabFocusNavigation="Local" motion:Motion.AnimateItems="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BackupRowViewModel">
                        <Grid Style="{StaticResource SettingsCard}" AutomationProperties.Name="{x:Bind Subtitle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Title}" />
                                <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource SettingsCardDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Content="Restore" Tag="{x:Bind}" Click="OnRestoreRow" />
                                <Button Tag="{x:Bind}" Click="OnDeleteRow" AutomationProperties.Name="Delete earlier save" ToolTipService.ToolTip="Delete earlier save">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
