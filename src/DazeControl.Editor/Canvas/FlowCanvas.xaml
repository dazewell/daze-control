<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DazeControl.Editor.Canvas.FlowCanvas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True" UseSystemFocusVisuals="False"
    AutomationProperties.Name="Flow canvas">

    <Grid x:Name="Root" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <!-- Wheel scrolls, Shift+wheel scrolls sideways, Ctrl+wheel and pinch zoom 50–200 % (UX §5.2). -->
        <ScrollViewer x:Name="Scroller" ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="2" IsTabStop="False"
                      HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                      ViewChanged="OnViewChanged">
            <Grid x:Name="Host" Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- All edges: a handful of paths, one per style, whatever the edge count (UX §5.8 #1, D-037). -->
                <Canvas x:Name="EdgeLayer" IsHitTestVisible="False">
                    <Path x:Name="NormalEdges" StrokeThickness="1.5" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                    <Path x:Name="MayFailEdges" StrokeThickness="1.5" StrokeDashArray="4 4" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                    <Path x:Name="AlwaysEdges" StrokeThickness="1.5" StrokeDashArray="4 2" Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                    <Path x:Name="IfFailsEdges" StrokeThickness="1.5" StrokeDashArray="4 2" Stroke="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Path x:Name="SelectedEdges" StrokeThickness="2" Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Path x:Name="NormalArrows" Fill="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
                    <Path x:Name="IfFailsArrows" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                    <Path x:Name="SelectedArrows" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                </Canvas>
                <Canvas x:Name="ChipLayer" IsHitTestVisible="False" />
                <Canvas x:Name="NodeLayer">
                    <Canvas.ChildrenTransitions>
                        <TransitionCollection>
                            <!-- Nodes glide to their slot after an edit (UX §5.3 motion); off with Animation effects. -->
                            <RepositionThemeTransition IsStaggeringEnabled="False" />
                        </TransitionCollection>
                    </Canvas.ChildrenTransitions>
                </Canvas>
                <Canvas x:Name="OverlayLayer" IsHitTestVisible="False">
                    <!-- Valid connect target glows accent; a refused one shows critical (UX §5.2). -->
                    <Rectangle x:Name="DropTarget" Visibility="Collapsed" StrokeThickness="2" RadiusX="30" RadiusY="30" />
                    <Path x:Name="ConnectPreview" Visibility="Collapsed" StrokeThickness="2" StrokeDashArray="3 2" />
                    <Ellipse x:Name="InPortDot" Visibility="Collapsed" Width="10" Height="10" StrokeThickness="1.5" />
                    <Ellipse x:Name="OutPortDot" Visibility="Collapsed" Width="10" Height="10" StrokeThickness="1.5" />
                    <Rectangle x:Name="FocusRing" Visibility="Collapsed" StrokeThickness="2" RadiusX="31" RadiusY="31"
                               Stroke="{ThemeResource FocusStrokeColorOuterBrush}" />
                    <Rectangle x:Name="Marquee" Visibility="Collapsed" StrokeThickness="1"
                               Stroke="{ThemeResource AccentFillColorDefaultBrush}" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <TeachingTip x:Name="RefusalTip" Title="Can't connect these" IsLightDismissEnabled="True" PreferredPlacement="Bottom" />

        <!-- Empty state (UX §5.2). -->
        <StackPanel x:Name="EmptyState" Visibility="Collapsed" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE945;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="No steps yet" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Steps run left to right. Ones side by side run at the same time." HorizontalAlignment="Center"
                       Style="{StaticResource SettingsCardDescription}" />
        </StackPanel>

    </Grid>
</UserControl>
