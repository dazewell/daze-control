<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DazeControl.Editor</AssemblyName>
    <RootNamespace>DazeControl.Editor</RootNamespace>
    <AssemblyTitle>Daze Control</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged, self-contained Windows App SDK, as in the OSD. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained Condition="'$(_IsPublishing)' == 'true'">true</SelfContained>
    <!-- Without it publish drops the .pri and .xbf files: the app dies loading XAML (OSD X-004). -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Own Main in Program.cs: single instance before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Window icon and About image, drawn by scripts/make-icon.ps1. -->
    <Content Include="..\..\assets\app.ico;..\..\assets\app.png" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- For About: ReleaseInfo throws in a self-contained app (as in the OSD). -->
    <AssemblyMetadata Include="WindowsAppSdkVersion"
                      Value="@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.WindowsAppSDK')->'%(Version)')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DazeControl.Core\DazeControl.Core.csproj" />
    <ProjectReference Include="..\DazeControl.Ipc\DazeControl.Ipc.csproj" />
    <ProjectReference Include="..\DazeControl.Editor.ViewModels\DazeControl.Editor.ViewModels.csproj" />
  </ItemGroup>

</Project>
