<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DazeControl.Editor.Inspector.InspectorPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DazeControl.Editor.Inspector"
    xmlns:motion="using:DazeControl.Editor"
    xmlns:vmi="using:DazeControl.Editor.ViewModels.Inspector"
    AutomationProperties.Name="Inspector">

    <UserControl.Resources>
        <Style x:Key="InspectorSection" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
        <Style x:Key="FieldTitle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="FieldError" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- Value controls never take the mouse wheel; it scrolls the pane (WheelGuard). -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="local:WheelGuard.IsEnabled" Value="True" />
        </Style>
        <Style TargetType="NumberBox" BasedOn="{StaticResource DefaultNumberBoxStyle}">
            <Setter Property="local:WheelGuard.IsEnabled" Value="True" />
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
            <Setter Property="local:WheelGuard.IsEnabled" Value="True" />
        </Style>
        <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="local:WheelGuard.IsEnabled" Value="True" />
        </Style>

        <!-- Device picker rows: glyph + name + state (UX §5.4). -->
        <DataTemplate x:Key="DeviceTemplate" x:DataType="vmi:DeviceOption">
            <Grid ColumnSpacing="10" AutomationProperties.Name="{x:Bind AutomationName}" Loaded="OnDeviceRowLoaded"
                  DataContextChanged="OnDeviceRowDataContextChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" Visibility="{x:Bind IsRow}" />
                <StackPanel Grid.Column="1" Visibility="{x:Bind IsRow}">
                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Caption}" Visibility="{x:Bind HasCaption}" Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                </StackPanel>
                <!-- "This flow's inputs" / "From this flow's inputs" / "Library": shown, never picked. -->
                <TextBlock Grid.ColumnSpan="2" Text="{x:Bind Title}" Visibility="{x:Bind IsHeader}" Style="{StaticResource CaptionTextBlockStyle}"
                           FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Suggestion rows: value + caption (UX §5.4, D-050). -->
        <DataTemplate x:Key="SuggestionTemplate" x:DataType="vmi:SuggestionItem">
            <StackPanel AutomationProperties.Name="{x:Bind AutomationName}">
                <TextBlock Text="{x:Bind Value}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Caption}" Visibility="{x:Bind HasCaption}" Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
        <!-- App rows: name, with the package id under it (D-094). -->
        <DataTemplate x:Key="AppTemplate" x:DataType="vmi:AppItem">
            <StackPanel AutomationProperties.Name="{x:Bind AutomationName}">
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{x:Bind Package}" Style="{StaticResource SettingsCardDescription}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ParamFieldTemplate" x:DataType="vmi:ParamFieldViewModel">
                            <StackPanel motion:Motion.Animate="True">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource FieldTitle}" />
                                <TextBox Visibility="{x:Bind IsText}" Text="{x:Bind Text, Mode=TwoWay}" PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                                         AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" KeyDown="OnCommitOnEnter" />
                                <ComboBox Visibility="{x:Bind IsSuggestText}" IsEditable="True" ItemsSource="{x:Bind Suggestions}"
                                          Text="{x:Bind Text, Mode=TwoWay}" PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                                          ItemTemplate="{StaticResource SuggestionTemplate}" HorizontalAlignment="Stretch" Tag="{x:Bind}"
                                          DropDownOpened="OnSuggestionsOpened" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                <!-- android.start: search the device's apps by name; Enter on other text keeps it as the package (D-094). -->
                                <AutoSuggestBox Visibility="{x:Bind IsAppPicker}" ItemsSource="{x:Bind AppRows}" Text="{x:Bind Text, Mode=OneWay}"
                                                TextMemberPath="Package" PlaceholderText="Search apps or type a package name" Tag="{x:Bind}"
                                                ItemTemplate="{StaticResource AppTemplate}" UpdateTextOnSelect="True"
                                                TextChanged="OnAppTextChanged" QuerySubmitted="OnAppSubmitted" GotFocus="OnAppFocused" LostFocus="OnAppLostFocus"
                                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind AppCaption, Mode=OneWay}" Visibility="{x:Bind HasAppCaption, Mode=OneWay}"
                                           Style="{StaticResource SettingsCardDescription}" Margin="0,4,0,0" />
                                <TextBlock Text="{x:Bind SuggestionHint, Mode=OneWay}" Visibility="{x:Bind HasSuggestionHint, Mode=OneWay}"
                                           Style="{StaticResource SettingsCardDescription}" Margin="0,4,0,0" />
                                <!-- Android input with no inputs yet: the link opens the device's inputs in the Library (L1). -->
                                <HyperlinkButton Content="{x:Bind SuggestionHint, Mode=OneWay}" Visibility="{x:Bind HasHintLink, Mode=OneWay}"
                                                 Click="OnHintLinkClick" Tag="{x:Bind}" Padding="0,4" />
                                <!-- Screens: a checklist of what's plugged in (D-051). -->
                                <StackPanel Visibility="{x:Bind IsChecklist}" Spacing="2">
                                    <ItemsControl ItemsSource="{x:Bind Screens}" AutomationProperties.Name="{x:Bind Title}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmi:ScreenCheckViewModel">
                                                <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" AutomationProperties.Name="{x:Bind AutomationName}">
                                                    <StackPanel>
                                                        <TextBlock Text="{x:Bind Title}" />
                                                        <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <HyperlinkButton Content="Use the screens that are on now" Tag="{x:Bind}" Click="OnUseScreensOnNow" Padding="0,4" />
                                </StackPanel>
                                <!-- Android keys: tokens in send order; Alt+Up/Down on a token's remove button moves it. -->
                                <StackPanel Visibility="{x:Bind IsTokenList}" Spacing="4">
                                    <ItemsControl motion:Motion.AnimateItems="True" ItemsSource="{x:Bind Tokens}" AutomationProperties.Name="{x:Bind Title}" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" motion:Motion.Animate="True" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmi:KeyTokenViewModel">
                                                <Grid ColumnSpacing="8" Padding="10,2,2,2" CornerRadius="{StaticResource ControlCornerRadius}"
                                                      Background="{ThemeResource ControlFillColorSecondaryBrush}" AutomationProperties.Name="{x:Bind AutomationName}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Text}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                                                    <Button Grid.Column="1" Tag="{x:Bind}" Click="OnRemoveToken" KeyDown="OnTokenKeyDown" Padding="6"
                                                            Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind RemoveName}"
                                                            ToolTipService.ToolTip="Remove (Alt+Up or Alt+Down moves it)">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <AutoSuggestBox PlaceholderText="Add a key" Tag="{x:Bind}" TextChanged="OnKeyTextChanged" UpdateTextOnSelect="False"
                                                    QuerySubmitted="OnKeySubmitted" GotFocus="OnKeyBoxFocused" AutomationProperties.Name="Add a key" />
                                </StackPanel>
                                <!-- menu.show: the flows of the menu in menu order (DESIGN 3.7); Alt+Up/Down on a remove button moves it. -->
                                <StackPanel Visibility="{x:Bind IsFlowList}" Spacing="4">
                                    <ItemsControl motion:Motion.AnimateItems="True" ItemsSource="{x:Bind FlowTokens, Mode=OneWay}" AutomationProperties.Name="{x:Bind Title}" IsTabStop="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" motion:Motion.Animate="True" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmi:FlowTokenViewModel">
                                                <StackPanel>
                                                    <Grid ColumnSpacing="8" Padding="10,2,2,2" CornerRadius="{StaticResource ControlCornerRadius}"
                                                          Background="{ThemeResource ControlFillColorSecondaryBrush}" AutomationProperties.Name="{x:Bind AutomationName}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="2" Text="{x:Bind Caption}" VerticalAlignment="Center"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <Button Grid.Column="3" Tag="{x:Bind}" Click="OnRemoveFlow" KeyDown="OnFlowKeyDown" Padding="6"
                                                                Background="Transparent" BorderThickness="0" AutomationProperties.Name="{x:Bind RemoveName}"
                                                                ToolTipService.ToolTip="Remove (Alt+Up or Alt+Down moves it)">
                                                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind Problem}" Visibility="{x:Bind HasProblem}" TextWrapping="Wrap"
                                                               Style="{StaticResource FieldError}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ComboBox ItemsSource="{x:Bind FlowChoices, Mode=OneWay}" PlaceholderText="Add a flow" HorizontalAlignment="Stretch"
                                              IsEnabled="{x:Bind CanAddFlow, Mode=OneWay}" SelectionChanged="OnFlowChosen" AutomationProperties.Name="Add a flow">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vmi:FlowChoice">
                                                <StackPanel Orientation="Horizontal" Spacing="8" AutomationProperties.Name="{x:Bind Name}">
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                                                    <TextBlock Text="{x:Bind Name}" />
                                                    <TextBlock Text="{x:Bind Caption}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBox Visibility="{x:Bind IsMultiline}" Text="{x:Bind Text, Mode=TwoWay}" PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                                         AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="64" MaxHeight="176"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         FontFamily="{x:Bind local:InspectorPane.Font(IsCode)}"
                                         AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                <Grid Visibility="{x:Bind IsFile}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind Text, Mode=TwoWay}" PlaceholderText="{x:Bind Placeholder, Mode=OneWay}"
                                             AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" KeyDown="OnCommitOnEnter" />
                                    <Button Grid.Column="1" Content="Browse" Tag="{x:Bind}" Click="OnBrowse"
                                            AutomationProperties.Name="{x:Bind local:InspectorPane.BrowseName(Title)}" />
                                </Grid>
                                <StackPanel Visibility="{x:Bind IsNumber}" Orientation="Horizontal" Spacing="8">
                                    <NumberBox Value="{x:Bind Number, Mode=TwoWay}" Minimum="{x:Bind Minimum}" Maximum="{x:Bind Maximum}"
                                               PlaceholderText="{x:Bind Placeholder, Mode=OneWay}" SpinButtonPlacementMode="Inline" MinWidth="140"
                                               ValidationMode="InvalidInputOverwritten" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Unit}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ToggleSwitch Visibility="{x:Bind IsBoolean}" IsOn="{x:Bind IsOn, Mode=TwoWay}" MinWidth="0"
                                              AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                <TextBlock Text="Mixed" Visibility="{x:Bind HasMixedCaption, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" />
                                <ComboBox Visibility="{x:Bind IsChoice}" ItemsSource="{x:Bind ChoiceOptions}" DisplayMemberPath="Caption" SelectedItem="{x:Bind ChoiceOption, Mode=TwoWay}" Loaded="OnPickerLoaded" SelectionChanged="OnPickerSelectionChanged"
                                          HorizontalAlignment="Stretch" PlaceholderText="{x:Bind MixedText, Mode=OneWay}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                <ComboBox Visibility="{x:Bind IsDevice}" PlaceholderText="{x:Bind MixedText, Mode=OneWay}" ItemsSource="{x:Bind Devices}" SelectedItem="{x:Bind Device, Mode=TwoWay}"
                                          Loaded="OnPickerLoaded" SelectionChanged="OnPickerSelectionChanged"
                                          ItemTemplate="{StaticResource DeviceTemplate}" HorizontalAlignment="Stretch" Tag="{x:Bind}"
                                          DropDownOpened="OnDevicesOpened" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                <!-- Run a flow › Inputs (UX §5.4): a device picker per input of the flow it runs. -->
                                <ItemsControl motion:Motion.AnimateItems="True" Visibility="{x:Bind IsCallInputs}" ItemsSource="{x:Bind CallInputs}" IsTabStop="False"
                                              AutomationProperties.Name="{x:Bind Title}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" motion:Motion.Animate="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vmi:CallInputViewModel">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource SettingsCardDescription}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{x:Bind Devices}" SelectedItem="{x:Bind Device, Mode=TwoWay}"
                                                          Loaded="OnPickerLoaded" SelectionChanged="OnPickerSelectionChanged"
                                                          ItemTemplate="{StaticResource DeviceTemplate}" HorizontalAlignment="Stretch" Tag="{x:Bind}"
                                                          DropDownOpened="OnPickerOpened" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind HasError, Mode=OneWay}" Style="{StaticResource FieldError}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind CallInputsHint, Mode=OneWay}" Visibility="{x:Bind HasCallInputsHint, Mode=OneWay}"
                                           Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                                <DropDownButton Visibility="{x:Bind HasExamples}" Content="Examples" Tag="{x:Bind}" Margin="0,6,0,0"
                                                AutomationProperties.Name="{x:Bind local:InspectorPane.ExamplesName(Title)}">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnExamplesOpening" />
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind HasError, Mode=OneWay}" Style="{StaticResource FieldError}" />
                                <TextBlock Text="{x:Bind Help}" Visibility="{x:Bind HasHelp}" Style="{StaticResource SettingsCardDescription}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Padding="16,8,16,24" Spacing="8" motion:Motion.Animate="True">

            <!-- ===== A step or a card ===== -->
            <StackPanel Visibility="{x:Bind ViewModel.IsNode, Mode=OneWay, FallbackValue=Collapsed}" Spacing="8" motion:Motion.Animate="True">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind ViewModel.Glyph, Mode=OneWay}" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Kind, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}"
                               VerticalAlignment="Center" />
                </Grid>
                <TextBox x:Name="NameBox" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" PlaceholderText="{x:Bind ViewModel.NamePlaceholder, Mode=OneWay}"
                         FontWeight="SemiBold" AutomationProperties.Name="Name" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                         KeyDown="OnCommitOnEnter" />

                <!-- Test this step -->
                <StackPanel Visibility="{x:Bind ViewModel.IsStep, Mode=OneWay}" Spacing="8" motion:Motion.Animate="True">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{x:Bind ViewModel.TestCommand, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanTest, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.TestTip, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.TestLabel, Mode=OneWay}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsTesting, Mode=OneWay}">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" Width="20" Height="20" />
                            <TextBlock Text="Testing…" VerticalAlignment="Center" />
                            <Button Content="Cancel" Command="{x:Bind ViewModel.CancelTestCommand, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Start the engine to test steps." Style="{StaticResource SettingsCardDescription}"
                               Visibility="{x:Bind local:InspectorPane.Not(ViewModel.EngineRunning), Mode=OneWay}" />
                    <InfoBar Severity="Success" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.TestResult, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.ShowTestSuccess, Mode=OneWay}" />
                    <InfoBar Severity="Error" IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.TestResult, Mode=OneWay}"
                             Visibility="{x:Bind ViewModel.ShowTestFailure, Mode=OneWay}">
                        <Expander Header="Show details" Visibility="{x:Bind ViewModel.HasTestDetails, Mode=OneWay}"
                                  HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <TextBlock Text="{x:Bind ViewModel.TestDetails, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                        </Expander>
                    </InfoBar>
                </StackPanel>

                <!-- Settings -->
                <TextBlock Text="Settings" Style="{StaticResource InspectorSection}" Visibility="{x:Bind ViewModel.HasFields, Mode=OneWay}" />
                <ItemsControl motion:Motion.AnimateItems="True" ItemsSource="{x:Bind ViewModel.Fields, Mode=OneWay}" IsTabStop="False" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" motion:Motion.Animate="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <StaticResource ResourceKey="ParamFieldTemplate" />
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <HyperlinkButton Content="Open this flow" Command="{x:Bind ViewModel.OpenCalledFlowCommand, Mode=OneWay}" Padding="0,4"
                                 Visibility="{x:Bind ViewModel.CanOpenCalledFlow, Mode=OneWay}" />

                <!-- Only if (D-081): the choices come from the step type's conditions; not shown when it has none. -->
                <StackPanel Visibility="{x:Bind ViewModel.HasOnlyIf, Mode=OneWay}" Spacing="4" motion:Motion.Animate="True"
                            Opacity="{x:Bind local:InspectorPane.DimStep(ViewModel.IsStep, ViewModel.OnlyIfIsSet), Mode=OneWay}">
                    <ComboBox x:Name="OnlyIfBox" Header="Only if" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.OnlyIfOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.OnlyIfIndex, Mode=TwoWay}" AutomationProperties.Name="Only if"
                              IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                    <TextBlock Text="Otherwise this step is skipped and the flow carries on." Style="{StaticResource SettingsCardDescription}" />
                    <TextBlock Text="Default" Style="{StaticResource SettingsCardDescription}"
                               Visibility="{x:Bind local:InspectorPane.ShowDefault(ViewModel.IsStep, ViewModel.OnlyIfIsSet), Mode=OneWay}" />
                    <HyperlinkButton Command="{x:Bind ViewModel.ResetOnlyIfCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ResetOnlyIfTip, Mode=OneWay}"
                                     Visibility="{x:Bind local:InspectorPane.ShowSet(ViewModel.IsStep, ViewModel.OnlyIfIsSet), Mode=OneWay}"
                                     AutomationProperties.Name="Reset Only if">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                </StackPanel>

                <!-- If it fails (UX §5.4): hover or focus previews what wouldn't run. -->
                <TextBlock Text="{x:Bind ViewModel.PolicySectionTitle, Mode=OneWay}" Style="{StaticResource InspectorSection}" />
                <RadioButtons x:Name="PolicyButtons" Opacity="{x:Bind local:InspectorPane.DimStep(ViewModel.IsStep, ViewModel.PolicyIsSet), Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.PolicyIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Bind ViewModel.PolicySectionTitle, Mode=OneWay}"
                              IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <RadioButton Tag="0" PointerEntered="OnPolicyHover" PointerExited="OnPolicyLeave" GotFocus="OnPolicyHover" LostFocus="OnPolicyLeave"
                                 AutomationProperties.Name="Stop the flow. If this fails, the whole flow stops.">
                        <StackPanel>
                            <TextBlock Text="Stop the flow" />
                            <TextBlock Text="If this fails, the whole flow stops." Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="1" PointerEntered="OnPolicyHover" PointerExited="OnPolicyLeave" GotFocus="OnPolicyHover" LostFocus="OnPolicyLeave"
                                 AutomationProperties.Name="Skip what follows. If this fails, the steps after it are skipped. Steps on other paths carry on. Only an &quot;When it works&quot; follow-up is skipped; an &quot;Only if it fails&quot; step runs.">
                        <StackPanel>
                            <TextBlock Text="Skip what follows" />
                            <TextBlock Text="If this fails, the steps after it are skipped. Steps on other paths carry on. Only an &quot;When it works&quot; follow-up is skipped; an &quot;Only if it fails&quot; step runs." Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Tag="2" PointerEntered="OnPolicyHover" PointerExited="OnPolicyLeave" GotFocus="OnPolicyHover" LostFocus="OnPolicyLeave"
                                 AutomationProperties.Name="Run the next steps anyway. If this fails, the steps after it still run, including the &quot;When it works&quot; ones, as if it had worked. Use it only when failure doesn't matter.">
                        <StackPanel>
                            <TextBlock Text="Run the next steps anyway" />
                            <TextBlock Text="If this fails, the steps after it still run, including the &quot;When it works&quot; ones, as if it had worked. Use it only when failure doesn't matter." Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                    </RadioButton>
                </RadioButtons>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                    <TextBlock Text="Default" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                           Visibility="{x:Bind local:InspectorPane.ShowDefault(ViewModel.IsStep, ViewModel.PolicyIsSet), Mode=OneWay}" />
                    <HyperlinkButton Command="{x:Bind ViewModel.ResetPolicyCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ResetPolicyTip, Mode=OneWay}"
                                 Visibility="{x:Bind local:InspectorPane.ShowSet(ViewModel.IsStep, ViewModel.PolicyIsSet), Mode=OneWay}"
                                 AutomationProperties.Name="Reset If it fails">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                        <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
                    </HyperlinkButton>
                </StackPanel>
                <!-- A fallback without hunting for an edge's menu: a new step, or one already in the flow, runs only if this fails. -->
                <DropDownButton x:Name="FallbackButton" Margin="0,8,0,0" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.FallbackTip, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" />
                        <TextBlock Text="{x:Bind ViewModel.FallbackText, Mode=OneWay}" />
                    </StackPanel>
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="FallbackMenu" Placement="Bottom" Opening="OnFallbackMenuOpening" />
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Connections: each edge at this step with its condition (UX §5.4). -->
                <StackPanel Visibility="{x:Bind ViewModel.HasConnections, Mode=OneWay}" Spacing="8" motion:Motion.Animate="True">
                    <TextBlock Text="Connections" Style="{StaticResource InspectorSection}" />
                    <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" IsTabStop="False" HorizontalContentAlignment="Stretch">
                    <ItemsControl motion:Motion.AnimateItems="True" ItemsSource="{x:Bind ViewModel.Connections}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vmi:ConnectionViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                    <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                                    <ComboBox ItemsSource="{x:Bind vmi:ConnectionViewModel.Conditions}" SelectedIndex="{x:Bind WhenIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ContentControl>
                </StackPanel>

                <!-- Timing -->
                <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" IsTabStop="False" HorizontalContentAlignment="Stretch">
                <StackPanel Visibility="{x:Bind ViewModel.IsStep, Mode=OneWay}" Spacing="8" motion:Motion.Animate="True">
                    <TextBlock Text="Timing" Style="{StaticResource InspectorSection}" />
                    <NumberBox Header="Try again" Value="{x:Bind ViewModel.Retries, Mode=TwoWay}" Minimum="0" Maximum="10"
                               Opacity="{x:Bind local:InspectorPane.Dim(ViewModel.RetriesIsSet), Mode=OneWay}"
                               SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="Default" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                                   Visibility="{x:Bind local:InspectorPane.ShowDefault(ViewModel.IsStep, ViewModel.RetriesIsSet), Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetRetriesCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ResetRetriesTip, Mode=OneWay}"
                                         Visibility="{x:Bind local:InspectorPane.ShowSet(ViewModel.IsStep, ViewModel.RetriesIsSet), Mode=OneWay}"
                                         AutomationProperties.Name="Reset Try again">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Header="Wait between tries" Value="{x:Bind ViewModel.RetryDelay, Mode=TwoWay}" Minimum="0" Maximum="86400"
                                   Opacity="{x:Bind local:InspectorPane.Dim(ViewModel.RetryDelayIsSet), Mode=OneWay}"
                                   SpinButtonPlacementMode="Inline" MinWidth="200" IsEnabled="{x:Bind ViewModel.CanRetryDelay, Mode=OneWay}" />
                        <TextBlock Text="s" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="Default" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                                   Visibility="{x:Bind local:InspectorPane.ShowDefault(ViewModel.IsStep, ViewModel.RetryDelayIsSet), Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetRetryDelayCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ResetRetryDelayTip, Mode=OneWay}"
                                         Visibility="{x:Bind local:InspectorPane.ShowSet(ViewModel.IsStep, ViewModel.RetryDelayIsSet), Mode=OneWay}"
                                         AutomationProperties.Name="Reset Wait between tries">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Header="Give up after" Value="{x:Bind ViewModel.Timeout, Mode=TwoWay}" Minimum="0" Maximum="86400"
                                   Opacity="{x:Bind local:InspectorPane.Dim(ViewModel.TimeoutIsSet), Mode=OneWay}"
                                   PlaceholderText="{x:Bind ViewModel.TimeoutPlaceholder, Mode=OneWay}" SpinButtonPlacementMode="Inline" MinWidth="200" />
                        <TextBlock Text="s" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="Default" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                                   Visibility="{x:Bind local:InspectorPane.ShowDefault(ViewModel.IsStep, ViewModel.TimeoutIsSet), Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetTimeoutCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ResetTimeoutTip, Mode=OneWay}"
                                         Visibility="{x:Bind local:InspectorPane.ShowSet(ViewModel.IsStep, ViewModel.TimeoutIsSet), Mode=OneWay}"
                                         AutomationProperties.Name="Reset Give up after">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE777;" FontSize="12" />
                                <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.DefaultsCaption, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}"
                               Visibility="{x:Bind ViewModel.HasDefaultsCaption, Mode=OneWay}" TextWrapping="Wrap" />
                    <!-- Use these for all … steps… (DESIGN A5): the flyout says how many steps follow; Apply has Undo below. -->
                    <Button Margin="0,4,0,0" HorizontalAlignment="Left" Content="{x:Bind ViewModel.UseForAllText, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.UseForAllText, Mode=OneWay}">
                        <Button.Flyout>
                            <Flyout x:Name="UseForAllFlyout" Placement="Top">
                                <StackPanel Spacing="8" MaxWidth="300">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.UseForAllValues, Mode=OneWay}" IsTabStop="False" />
                                    <TextBlock Text="{x:Bind ViewModel.UseForAllApplies, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Apply" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.ApplyUseForAllCommand}" Click="OnUseForAllClosed" />
                                        <Button Content="Cancel" Click="OnUseForAllClosed" />
                                    </StackPanel>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <InfoBar IsOpen="{x:Bind ViewModel.HasDefaultsNotice, Mode=OneWay}" Severity="Success" IsClosable="True" Message="{x:Bind ViewModel.DefaultsNotice, Mode=OneWay}"
                             CloseButtonCommand="{x:Bind ViewModel.DismissDefaultsNoticeCommand}">
                        <InfoBar.ActionButton>
                            <Button Content="Undo" Command="{x:Bind ViewModel.UndoDefaultsCommand}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                </ContentControl>
            </StackPanel>

            <!-- ===== Several selected ===== -->
            <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" IsTabStop="False" HorizontalContentAlignment="Stretch">
            <StackPanel Visibility="{x:Bind ViewModel.IsMany, Mode=OneWay, FallbackValue=Collapsed}" Spacing="8" Margin="0,8,0,0" motion:Motion.Animate="True">
                <TextBlock Text="{x:Bind ViewModel.ManyHeader, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" />
                <InfoBar IsOpen="{x:Bind ViewModel.HasManyProblem, Mode=OneWay}" Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.ManyProblem, Mode=OneWay}" />

                <!-- Params every selected step has (T15.3): the same controls as for one step; differing values read "Mixed". -->
                <TextBlock Text="Settings" Style="{StaticResource InspectorSection}" Visibility="{x:Bind ViewModel.ManyHasFields, Mode=OneWay}" />
                <ItemsControl motion:Motion.AnimateItems="True" ItemsSource="{x:Bind ViewModel.ManyFields, Mode=OneWay}" IsTabStop="False" ItemTemplate="{StaticResource ParamFieldTemplate}"
                              Visibility="{x:Bind ViewModel.ManyHasFields, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12" motion:Motion.Animate="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Only if: one step type with conditions (DESIGN D2). -->
                <StackPanel Visibility="{x:Bind ViewModel.ManyHasOnlyIf, Mode=OneWay}" Spacing="4" Opacity="{x:Bind local:InspectorPane.DimRow(ViewModel.ManyOnlyView), Mode=OneWay}">
                    <ComboBox Header="Only if" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ManyOnlyOptions, Mode=OneWay}"
                              SelectedIndex="{x:Bind ViewModel.ManyOnlyIndex, Mode=TwoWay}" PlaceholderText="Mixed"
                              AutomationProperties.Name="{x:Bind ViewModel.ManyOnlyView.Name, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="{x:Bind ViewModel.ManyOnlyView.Caption, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.ManyOnlyView.ShowCaption, Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetManyOnlyCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ManyOnlyView.ResetTip, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.ManyOnlyView.ShowReset, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind ViewModel.ManyOnlyView.ResetTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.ManyPolicyTitle, Mode=OneWay}" Style="{StaticResource InspectorSection}" />
                <RadioButtons SelectedIndex="{x:Bind ViewModel.ManyPolicyIndex, Mode=TwoWay}" Opacity="{x:Bind local:InspectorPane.DimRow(ViewModel.ManyPolicyView), Mode=OneWay}"
                              AutomationProperties.Name="{x:Bind ViewModel.ManyPolicyView.Name, Mode=OneWay}">
                    <RadioButton AutomationProperties.Name="Stop the flow. If this fails, the whole flow stops.">
                        <StackPanel>
                            <TextBlock Text="Stop the flow" />
                            <TextBlock Text="If this fails, the whole flow stops." Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="Skip what follows. If this fails, the steps after it are skipped. Steps on other paths carry on. Only an &quot;When it works&quot; follow-up is skipped; an &quot;Only if it fails&quot; step runs.">
                        <StackPanel>
                            <TextBlock Text="Skip what follows" />
                            <TextBlock Text="If this fails, the steps after it are skipped. Steps on other paths carry on. Only an &quot;When it works&quot; follow-up is skipped; an &quot;Only if it fails&quot; step runs." Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton AutomationProperties.Name="Run the next steps anyway. If this fails, the steps after it still run, including the &quot;When it works&quot; ones, as if it had worked. Use it only when failure doesn't matter.">
                        <StackPanel>
                            <TextBlock Text="Run the next steps anyway" />
                            <TextBlock Text="If this fails, the steps after it still run, including the &quot;When it works&quot; ones, as if it had worked. Use it only when failure doesn't matter." Style="{StaticResource SettingsCardDescription}" />
                        </StackPanel>
                    </RadioButton>
                </RadioButtons>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="{x:Bind ViewModel.ManyPolicyView.Caption, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.ManyPolicyView.ShowCaption, Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetManyPolicyCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ManyPolicyView.ResetTip, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.ManyPolicyView.ShowReset, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind ViewModel.ManyPolicyView.ResetTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                    </StackPanel>

                <StackPanel Visibility="{x:Bind ViewModel.ManyHasTiming, Mode=OneWay}" Spacing="8">
                    <TextBlock Text="Timing" Style="{StaticResource InspectorSection}" />
                    <NumberBox Header="Try again" Value="{x:Bind ViewModel.ManyRetries, Mode=TwoWay}" Minimum="0" Maximum="10"
                               PlaceholderText="Mixed" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" MinWidth="200"
                               Opacity="{x:Bind local:InspectorPane.DimRow(ViewModel.ManyRetriesView), Mode=OneWay}"
                               AutomationProperties.Name="{x:Bind ViewModel.ManyRetriesView.Name, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="{x:Bind ViewModel.ManyRetriesView.Caption, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.ManyRetriesView.ShowCaption, Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetManyRetriesCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ManyRetriesView.ResetTip, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.ManyRetriesView.ShowReset, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind ViewModel.ManyRetriesView.ResetTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Header="Wait between tries" Value="{x:Bind ViewModel.ManyRetryDelay, Mode=TwoWay}" Minimum="0" Maximum="86400"
                               PlaceholderText="Mixed" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" MinWidth="200"
                               Opacity="{x:Bind local:InspectorPane.DimRow(ViewModel.ManyRetryDelayView), Mode=OneWay}"
                               AutomationProperties.Name="{x:Bind ViewModel.ManyRetryDelayView.Name, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.ManyCanRetryDelay, Mode=OneWay}" />
                        <TextBlock Text="s" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="{x:Bind ViewModel.ManyRetryDelayView.Caption, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.ManyRetryDelayView.ShowCaption, Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetManyRetryDelayCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ManyRetryDelayView.ResetTip, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.ManyRetryDelayView.ShowReset, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind ViewModel.ManyRetryDelayView.ResetTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <NumberBox Header="Give up after" Value="{x:Bind ViewModel.ManyTimeout, Mode=TwoWay}" Minimum="0" Maximum="86400"
                               PlaceholderText="Mixed" SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" MinWidth="200"
                               Opacity="{x:Bind local:InspectorPane.DimRow(ViewModel.ManyTimeoutView), Mode=OneWay}"
                               AutomationProperties.Name="{x:Bind ViewModel.ManyTimeoutView.Name, Mode=OneWay}" />
                        <TextBlock Text="s" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-4,0,0" motion:Motion.Animate="True">
                        <TextBlock Text="{x:Bind ViewModel.ManyTimeoutView.Caption, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.ManyTimeoutView.ShowCaption, Mode=OneWay}" />
                        <HyperlinkButton Command="{x:Bind ViewModel.ResetManyTimeoutCommand}" Padding="0,2" ToolTipService.ToolTip="{x:Bind ViewModel.ManyTimeoutView.ResetTip, Mode=OneWay}"
                                     Visibility="{x:Bind ViewModel.ManyTimeoutView.ShowReset, Mode=OneWay}"
                                     AutomationProperties.Name="{x:Bind ViewModel.ManyTimeoutView.ResetTip, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE777;" FontSize="12" />
                            <TextBlock Text="Reset" Style="{StaticResource SettingsCardDescription}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </ContentControl>

            <!-- ===== Nothing selected: the flow's settings (UX §5.4) ===== -->
            <ContentControl IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" IsTabStop="False" HorizontalContentAlignment="Stretch">
            <StackPanel Visibility="{x:Bind ViewModel.IsFlow, Mode=OneWay, FallbackValue=Collapsed}" Spacing="12">
                <TextBlock Text="Flow" Style="{StaticResource SettingsCardDescription}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="GlyphButton" AutomationProperties.Name="Icon" ToolTipService.ToolTip="Icon" Padding="8" VerticalAlignment="Bottom">
                        <FontIcon Glyph="{x:Bind ViewModel.FlowGlyph, Mode=OneWay}" FontSize="16" />
                        <Button.Flyout>
                            <Flyout x:Name="GlyphFlyout">
                                <GridView x:Name="GlyphGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnGlyphClick" MaxWidth="260"
                                          AutomationProperties.Name="Icons">
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="vmi:GlyphOption">
                                            <Grid Width="40" Height="40" AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <TextBox Grid.Column="1" Header="Name" Text="{x:Bind ViewModel.FlowName, Mode=TwoWay}" KeyDown="OnCommitOnEnter"
                             IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" />
                </Grid>

                <ComboBox Header="Group" IsEditable="True" LostFocus="OnGroupLostFocus" Text="{x:Bind ViewModel.TrayFolder, Mode=TwoWay}"
                          AutomationProperties.HelpText="Also the folder in the tray menu"
                          ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}" PlaceholderText="None" HorizontalAlignment="Stretch" />
                <CheckBox Content="Line above it" IsChecked="{x:Bind ViewModel.LineAbove, Mode=TwoWay}" />

                <TextBlock Text="When this runs" Style="{StaticResource InspectorSection}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" motion:Motion.Animate="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmi:ShortcutViewModel">
                            <StackPanel>
                                <local:HotkeyRecorder Hotkey="{x:Bind Hotkey, Mode=OneWay}" Tag="{x:Bind}" AccessibleName="Shortcut"
                                                      Recorded="OnShortcutRecorded" Rejected="OnShortcutRejected" TypedRefused="OnShortcutTypedRefused" RecordingChanged="OnShortcutRecording"
                                                      HorizontalAlignment="Left" />
                                <!-- UX §5.7 H1–H4, H7 or the shortcut's problem; a refusal is read out by the recorder's UIA notification (no live region: it would read twice). -->
                                <TextBlock Text="{x:Bind Note, Mode=OneWay}" Visibility="{x:Bind HasNote, Mode=OneWay}" Style="{StaticResource FieldError}" />
                                <!-- UX §5.7 H8: a number-pad key alone takes that digit from typing. -->
                                <TextBlock Text="{x:Bind Tip, Mode=OneWay}" Visibility="{x:Bind HasTip, Mode=OneWay}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <HyperlinkButton Content="Add shortcut" Command="{x:Bind ViewModel.AddShortcutCommand, Mode=OneWay}" Padding="0,4" />

                <!-- M20 T20.6 (DESIGN §5): a row per schedule or event, a plain sentence on top, the pickers when opened. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Triggers, Mode=OneWay}" IsTabStop="False" Margin="0,8,0,0" AutomationProperties.Name="Schedules and events">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmi:TriggerRowViewModel">
                            <Expander IsExpanded="{x:Bind IsOpen, Mode=TwoWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      AutomationProperties.Name="{x:Bind Sentence}">
                                <Expander.Header>
                                    <Grid ColumnSpacing="10" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Sentence}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <TextBlock Text="{x:Bind Next}" Visibility="{x:Bind HasNext}" Style="{StaticResource SettingsCardDescription}" />
                                        </StackPanel>
                                    </Grid>
                                </Expander.Header>
                                <StackPanel Spacing="12">
                                    <ComboBox ItemsSource="{x:Bind vmi:TriggerRowViewModel.KindNames}" SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Header="Starts" AutomationProperties.Name="Starts" />

                                    <StackPanel Spacing="8" Visibility="{x:Bind IsAt}">
                                        <TimePicker Time="{x:Bind Time, Mode=TwoWay}" ClockIdentifier="24HourClock" Header="At" MinuteIncrement="1" />
                                        <TextBlock Text="On" Style="{StaticResource CaptionTextBlockStyle}" />
                                        <ItemsRepeater ItemsSource="{x:Bind DayToggles}" AutomationProperties.Name="Days">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="52" MinRowSpacing="4" MinColumnSpacing="4" ItemsStretch="Fill" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vmi:DayToggleViewModel">
                                                    <ToggleButton Content="{x:Bind Name}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" MinWidth="0" Padding="4,6"
                                                                  HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind Name}" />
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>

                                    <StackPanel Spacing="8" Visibility="{x:Bind IsEvery}">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Value="{x:Bind IntervalCount, Mode=TwoWay}" Minimum="1" Maximum="{x:Bind IntervalMax, Mode=OneWay}" SpinButtonPlacementMode="Compact"
                                                       Header="Every" AutomationProperties.Name="Interval" />
                                            <ComboBox Grid.Column="1" ItemsSource="{x:Bind vmi:TriggerRowViewModel.UnitNames}" SelectedIndex="{x:Bind IntervalUnitIndex, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom" AutomationProperties.Name="Unit" />
                                        </Grid>
                                        <CheckBox Content="Only between two times" IsChecked="{x:Bind HasWindow, Mode=TwoWay}" />
                                        <StackPanel Spacing="8" Visibility="{x:Bind HasWindow, Mode=OneWay}">
                                            <TimePicker Time="{x:Bind From, Mode=TwoWay}" ClockIdentifier="24HourClock" Header="From" />
                                            <TimePicker Time="{x:Bind To, Mode=TwoWay}" ClockIdentifier="24HourClock" Header="Until" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="8" Visibility="{x:Bind IsOnce}">
                                        <DatePicker Date="{x:Bind OnceDate, Mode=TwoWay}" Header="On" />
                                        <TimePicker Time="{x:Bind Time, Mode=TwoWay}" ClockIdentifier="24HourClock" Header="At" />
                                    </StackPanel>

                                    <StackPanel Spacing="8" Visibility="{x:Bind IsEvent}">
                                        <ComboBox ItemsSource="{x:Bind vmi:TriggerRowViewModel.EventNames}" SelectedIndex="{x:Bind EventIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Header="When" AutomationProperties.Name="When" />
                                        <ComboBox ItemsSource="{x:Bind vmi:TriggerRowViewModel.ConnectionNames}" SelectedIndex="{x:Bind ConnectionIndex, Mode=TwoWay}"
                                                  Visibility="{x:Bind IsNetwork}" HorizontalAlignment="Stretch" Header="Connection" AutomationProperties.Name="Connection" />
                                        <TextBox Text="{x:Bind NetworkName, Mode=TwoWay}" Visibility="{x:Bind ShowNetworkName, Mode=OneWay}"
                                                 Header="Wi-Fi network name" PlaceholderText="Any Wi-Fi network" AutomationProperties.Name="Wi-Fi network name" />
                                        <ComboBox ItemsSource="{x:Bind vmi:TriggerRowViewModel.OnlyNames}" SelectedIndex="{x:Bind OnlyIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Header="Run it" AutomationProperties.Name="Run it" />
                                    </StackPanel>

                                    <!-- Missed runs are chosen per schedule when it is created (D-107). -->
                                    <StackPanel Spacing="8" Visibility="{x:Bind IsSchedule}">
                                        <ComboBox ItemsSource="{x:Bind vmi:TriggerRowViewModel.IfMissedNames}" SelectedIndex="{x:Bind IfMissedIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch" Header="If the PC was off or asleep at that time" AutomationProperties.Name="If the PC was off or asleep at that time" />
                                        <NumberBox Value="{x:Bind GraceMinutes, Mode=TwoWay}" Minimum="0" Maximum="1440" SpinButtonPlacementMode="Compact"
                                                   Header="Run it only if it is no more than this many minutes late" Visibility="{x:Bind ShowGrace, Mode=OneWay}"
                                                   AutomationProperties.Name="Minutes late" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Test this trigger" Command="{x:Bind TestCommand}" AutomationProperties.Name="{x:Bind TestName}"
                                                ToolTipService.ToolTip="Runs the saved flow now, the way this would start it" />
                                        <Button Content="Remove" Command="{x:Bind RemoveCommand}" AutomationProperties.Name="{x:Bind RemoveName}" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind TestResult, Mode=OneWay}" Visibility="{x:Bind HasTestResult, Mode=OneWay}" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Vertical">
                    <HyperlinkButton Content="Add schedule" Command="{x:Bind ViewModel.AddScheduleCommand, Mode=OneWay}" Padding="0,4" />
                    <HyperlinkButton Content="Add event" Command="{x:Bind ViewModel.AddEventCommand, Mode=OneWay}" Padding="0,4" />
                    <Button Content="Add events…" Padding="0,4" Style="{StaticResource TextBlockButtonStyle}" AutomationProperties.Name="Add several events at once">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.EventGroups}" IsTabStop="False" AutomationProperties.Name="Events">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vmi:EventGroupViewModel">
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource InspectorSection}" />
                                                    <ItemsControl ItemsSource="{x:Bind Events}" IsTabStop="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vmi:EventOptionViewModel">
                                                                <CheckBox Content="{x:Bind Sentence}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                                                          AutomationProperties.Name="{x:Bind Sentence}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.TriggerNotes, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasTriggerNotes, Mode=OneWay}"
                           TextWrapping="Wrap" Style="{StaticResource FieldError}" />
                <TextBlock Text="{x:Bind vmi:InspectorViewModel.AddScheduleHelp}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescription}" />

                <!-- D-049, UX §5.4: "Shortcut" alone is a hotkey; the .lnk is always the desktop shortcut. -->
                <TextBlock Text="Desktop shortcut" Style="{StaticResource InspectorSection}" />
                <TextBlock Text="{x:Bind ViewModel.DesktopStatus, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Add to desktop" Command="{x:Bind ViewModel.AddToDesktopCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanAddToDesktop, Mode=OneWay}" Visibility="{x:Bind ViewModel.ShowAddToDesktop, Mode=OneWay}" />
                    <Button Content="Update" Command="{x:Bind ViewModel.AddToDesktopCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CanUpdateDesktop, Mode=OneWay}"
                            ToolTipService.ToolTip="Give the desktop shortcut this flow's name" />
                    <Button Content="Remove" Command="{x:Bind ViewModel.RemoveFromDesktopCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanRemoveFromDesktop, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDesktopShortcut, Mode=OneWay}"
                            AutomationProperties.Name="Remove desktop shortcut" />
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.DesktopError, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasDesktopError, Mode=OneWay}"
                           TextWrapping="Wrap" Style="{StaticResource FieldError}" />

                <TextBlock Text="If it's already running" Style="{StaticResource InspectorSection}" />
                <RadioButtons SelectedIndex="{x:Bind ViewModel.WhenRunningIndex, Mode=TwoWay}" AutomationProperties.Name="If it's already running">
                    <RadioButton Content="Ignore it" />
                    <RadioButton Content="Run it after" />
                    <RadioButton Content="Start over" />
                </RadioButtons>

                <ToggleSwitch Header="Show the pop-up while it runs" IsOn="{x:Bind ViewModel.ShowPopup, Mode=TwoWay}" Margin="0,8,0,0" />

                <!-- Inputs (D-064, UX §5.4): devices another flow may pick when it runs this one. -->
                <TextBlock Text="Inputs" Style="{StaticResource InspectorSection}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Inputs, Mode=OneWay}" IsTabStop="False" AutomationProperties.Name="Inputs">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vmi:FlowInputViewModel">
                            <StackPanel Spacing="8">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{x:Bind Label, Mode=TwoWay}" PlaceholderText="Name" KeyDown="OnCommitOnEnter"
                                             AutomationProperties.Name="Input name" />
                                    <Button Grid.Column="1" Click="OnRemoveInput" Tag="{x:Bind}" Padding="8" VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Bind RemoveName, Mode=OneWay}" ToolTipService.ToolTip="Remove">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                                    </Button>
                                </Grid>
                                <ComboBox ItemsSource="{x:Bind vmi:FlowInputViewModel.KindNames}" SelectedIndex="{x:Bind KindIndex, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" AutomationProperties.Name="Kind" />
                                <ComboBox ItemsSource="{x:Bind Devices}" SelectedItem="{x:Bind Device, Mode=TwoWay}" PlaceholderText="Default device"
                                          Loaded="OnPickerLoaded" SelectionChanged="OnPickerSelectionChanged"
                                          ItemTemplate="{StaticResource DeviceTemplate}" HorizontalAlignment="Stretch" Tag="{x:Bind}"
                                          DropDownOpened="OnPickerOpened" AutomationProperties.Name="{x:Bind DefaultName, Mode=OneWay}" />
                                <ToggleSwitch Header="Ask me when it runs" IsOn="{x:Bind Ask, Mode=TwoWay}" OnContent="Yes" OffContent="No"
                                              AutomationProperties.Name="{x:Bind AskName, Mode=OneWay}" />
                                <StackPanel Spacing="8" Visibility="{x:Bind Ask, Mode=OneWay}">
                                    <NumberBox Value="{x:Bind TimeoutSeconds, Mode=TwoWay}" Minimum="5" Maximum="600" SpinButtonPlacementMode="Compact"
                                               Header="Seconds to wait for an answer" AutomationProperties.Name="Seconds to wait" />
                                    <ComboBox ItemsSource="{x:Bind vmi:FlowInputViewModel.OnTimeoutNames}" SelectedIndex="{x:Bind OnTimeoutIndex, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Header="If nobody answers" AutomationProperties.Name="If nobody answers" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Error, Mode=OneWay}" Visibility="{x:Bind HasError, Mode=OneWay}" Style="{StaticResource FieldError}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind ViewModel.InputTip, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasInputTip, Mode=OneWay}"
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <HyperlinkButton Content="Add an input" Command="{x:Bind ViewModel.AddInputCommand, Mode=OneWay}" Padding="0,4" />
                <TextBlock Text="{x:Bind vmi:InspectorViewModel.AddInputHelp}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescription}" />
            </StackPanel>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
