<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DazeControl.Editor.Library.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vml="using:DazeControl.Editor.ViewModels.LibraryPage"
    xmlns:vmi="using:DazeControl.Editor.ViewModels.Inspector">

    <!-- Library (UX §5.1): a Pivot per kind; settings cards with live state, "Used by 2 flows" and Test. -->
    <Pivot x:Name="SectionsPivot" Margin="-12,0,-12,0" SelectionChanged="OnSectionChanged" AutomationProperties.Name="Library">
        <Pivot.HeaderTemplate>
            <DataTemplate x:DataType="vml:LibrarySectionViewModel">
                <TextBlock Text="{x:Bind Title}" />
            </DataTemplate>
        </Pivot.HeaderTemplate>
        <Pivot.ItemTemplate>
            <DataTemplate x:DataType="vml:LibrarySectionViewModel">
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <!-- Section commands -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Visibility="{x:Bind CanAdd}" IsEnabled="{x:Bind HasAvailable, Mode=OneWay}" AutomationProperties.Name="Add from Windows"
                                ToolTipService.ToolTip="Devices Windows sees that aren't in your Library yet">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add from Windows" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ListView ItemsSource="{x:Bind Available, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                                              ItemClick="OnAddClick" MinWidth="280" AutomationProperties.Name="Devices from Windows">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vmi:DeviceOption">
                                                <Grid ColumnSpacing="10" Padding="0,6" AutomationProperties.Name="{x:Bind AutomationName}"
                                                      Loaded="OnDeviceRowLoaded" DataContextChanged="OnDeviceRowDataContextChanged">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{x:Bind Title}" />
                                                        <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Visibility="{x:Bind CanCapture}" Click="OnCapture" AutomationProperties.Name="Capture current layout"
                                ToolTipService.ToolTip="Saves how your screens are set up now.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE722;" FontSize="14" />
                                <TextBlock Text="Capture current layout" />
                                <ProgressRing IsActive="{x:Bind IsCapturing, Mode=OneWay}" Width="14" Height="14" />
                            </StackPanel>
                        </Button>
                        <!-- Bound devices (D-116): pick a Bluetooth device and its audio device, name the pair. -->
                        <Button Visibility="{x:Bind CanBind}" IsEnabled="{x:Bind HasBindChoices, Mode=OneWay}" AutomationProperties.Name="Bind devices"
                                ToolTipService.ToolTip="Use a Bluetooth device and its audio device as one device in steps">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Bind devices" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="8" MinWidth="300">
                                        <ComboBox Header="Bluetooth device" ItemsSource="{x:Bind BindBluetoothChoices, Mode=OneWay}"
                                                  SelectedItem="{x:Bind BindBluetooth, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <ComboBox Header="Audio device" ItemsSource="{x:Bind BindAudioChoices, Mode=OneWay}"
                                                  SelectedItem="{x:Bind BindAudio, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                        <TextBox Header="Name" Text="{x:Bind BindName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Technics headphones" />
                                        <TextBlock Text="{x:Bind BindError, Mode=OneWay}" Visibility="{x:Bind HasBindError, Mode=OneWay}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                        <Button Content="Bind" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right" Click="OnBindSave" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Click="OnRefresh" ToolTipService.ToolTip="Check what's connected now" AutomationProperties.Name="Refresh"
                                Visibility="{x:Bind CanAdd}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <InfoBar Severity="Warning" IsOpen="{x:Bind HasNote, Mode=OneWay}" IsClosable="False" Message="{x:Bind Note, Mode=OneWay}" />

                    <!-- Empty state -->
                    <StackPanel Visibility="{x:Bind IsEmpty, Mode=OneWay}" Spacing="8" Margin="0,40,0,0" HorizontalAlignment="Center">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind EmptyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                                   Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind Items}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vml:LibraryItemViewModel">
                                <StackPanel Spacing="0">
                                    <Grid Style="{StaticResource SettingsCard}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource SettingsCardIcon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasProblem, Mode=OneWay}">
                                                <FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="{x:Bind Problem, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- "Used by 2 flows" opens a list of them; picking one opens it in the editor. -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind UsedByText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,12,0"
                                                   Style="{StaticResource SettingsCardDescription}" Visibility="{x:Bind IsUnused, Mode=OneWay}" />
                                        <HyperlinkButton Grid.Column="2" Content="{x:Bind UsedByText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                                                         Visibility="{x:Bind IsUsed, Mode=OneWay}" AutomationProperties.Name="{x:Bind UsedByName, Mode=OneWay}" Click="OnUsedByOpen">
                                            <FlyoutBase.AttachedFlyout>
                                                <Flyout Placement="Bottom">
                                                    <ListView ItemsSource="{x:Bind UsedByFlows, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                                                              ItemClick="OnUsedByClick" MinWidth="220" AutomationProperties.Name="Flows that use it">
                                                        <ListView.ItemTemplate>
                                                            <DataTemplate x:DataType="vml:FlowLink">
                                                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,6">
                                                                    <FontIcon Glyph="&#xE945;" FontSize="14" />
                                                                    <TextBlock Text="{x:Bind Name}" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ListView.ItemTemplate>
                                                    </ListView>
                                                </Flyout>
                                            </FlyoutBase.AttachedFlyout>
                                        </HyperlinkButton>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <ToggleButton IsChecked="{x:Bind ShowDetails, Mode=TwoWay}" Visibility="{x:Bind HasDetails, Mode=OneWay}"
                                                          ToolTipService.ToolTip="What the layout saved" AutomationProperties.Name="{x:Bind DetailsName, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE946;" FontSize="14" />
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{x:Bind ShowSides, Mode=TwoWay}" Visibility="{x:Bind IsBound}"
                                                          ToolTipService.ToolTip="Which devices it binds" AutomationProperties.Name="{x:Bind SidesName, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                                    <TextBlock Text="Devices" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <ToggleButton IsChecked="{x:Bind ShowInputs, Mode=TwoWay}" Visibility="{x:Bind HasInputs}"
                                                          ToolTipService.ToolTip="Inputs" AutomationProperties.Name="{x:Bind InputsName, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                                                    <TextBlock Text="Inputs" />
                                                </StackPanel>
                                            </ToggleButton>
                                            <Button Visibility="{x:Bind CanRename, Mode=OneWay}" ToolTipService.ToolTip="Rename"
                                                    AutomationProperties.Name="{x:Bind RenameName, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel Spacing="8" MinWidth="260">
                                                            <TextBlock Text="Flows that use it keep working." Style="{StaticResource SettingsCardDescription}" />
                                                            <TextBox Text="{x:Bind Key}" Header="Name" KeyDown="OnRenameKeyDown" Tag="{x:Bind}" />
                                                            <TextBlock Text="{x:Bind RenameError, Mode=OneWay}" Visibility="{x:Bind HasRenameError, Mode=OneWay}"
                                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                            <Button Content="Rename" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                                                                    Click="OnRenameSave" Tag="{x:Bind}" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button Visibility="{x:Bind CanOpenLocation}" Click="OnOpenLocation" Tag="{x:Bind}"
                                                    ToolTipService.ToolTip="Open file location" AutomationProperties.Name="{x:Bind OpenLocationName, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                                            </Button>
                                            <Button Command="{x:Bind TestCommand}" IsEnabled="{x:Bind CanTest, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind TestName, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ProgressRing IsActive="{x:Bind IsTesting, Mode=OneWay}" Width="14" Height="14"
                                                                  Visibility="{x:Bind IsTesting, Mode=OneWay}" />
                                                    <TextBlock Text="Test" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <!-- Always there for removable kinds, so every row lines up; off while a flow uses it. The tooltip
                                             sits on a wrapper because a disabled button shows none. -->
                                        <Border Grid.Column="4" Margin="4,0,0,0" Background="Transparent" VerticalAlignment="Center"
                                                Visibility="{x:Bind Removable, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind RemoveTip, Mode=OneWay}">
                                            <Button Click="OnRemove" Tag="{x:Bind}" IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                                    AutomationProperties.Name="{x:Bind RemoveName, Mode=OneWay}"
                                                    AutomationProperties.HelpText="{x:Bind RemoveTip, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                            </Button>
                                        </Border>
                                    </Grid>
                                    <!-- Displays › details: each screen as the layout saved it. -->
                                    <Border Visibility="{x:Bind ShowDetails, Mode=OneWay}" Padding="58,8,16,12" Margin="0,1,0,0" CornerRadius="0,0,4,4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <ItemsRepeater ItemsSource="{x:Bind Screens, Mode=OneWay}">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Spacing="6" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vml:ScreenDetail">
                                                    <!-- Name over one wrapping line, so a narrow window loses nothing. -->
                                                    <StackPanel AutomationProperties.Name="{x:Bind}">
                                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Style="{StaticResource SettingsCardDescription}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </Border>
                                    <!-- Bound devices › Devices (D-116): change either side; steps using it follow. -->
                                    <Border Visibility="{x:Bind ShowSides, Mode=OneWay}" Padding="58,8,16,12" Margin="0,1,0,0" CornerRadius="0,0,4,4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel Spacing="8" AutomationProperties.Name="{x:Bind SidesName, Mode=OneWay}">
                                            <TextBlock Text="Bluetooth steps connect the Bluetooth device; audio steps use the audio device."
                                                       Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                                            <ComboBox Header="Bluetooth device" ItemsSource="{x:Bind BluetoothChoices, Mode=OneWay}" MinWidth="260"
                                                      SelectedItem="{x:Bind BoundBluetooth, Mode=TwoWay}" IsEnabled="{x:Bind CanEditSides, Mode=OneWay}" />
                                            <ComboBox Header="Audio device" ItemsSource="{x:Bind AudioChoices, Mode=OneWay}" MinWidth="260"
                                                      SelectedItem="{x:Bind BoundAudio, Mode=TwoWay}" IsEnabled="{x:Bind CanEditSides, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Android › Inputs (L1): each input's D-pad moves in order; rename (steps follow), remove (off while used). -->
                                    <Border Visibility="{x:Bind ShowInputs, Mode=OneWay}" Padding="58,8,16,12" Margin="0,1,0,0" CornerRadius="0,0,4,4"
                                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel Spacing="8" AutomationProperties.Name="{x:Bind InputsName, Mode=OneWay}">
                                            <TextBlock Text="Each input is the moves from where the TV's input list opens to it, in order."
                                                       Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                                            <TextBlock Text="No inputs yet." Visibility="{x:Bind HasNoInputs, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" />
                                            <ItemsRepeater ItemsSource="{x:Bind Inputs}">
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="12" />
                                                </ItemsRepeater.Layout>
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="vml:AndroidInputViewModel">
                                                        <Grid ColumnSpacing="8" RowSpacing="6" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                                <TextBlock Text="{x:Bind UsedByText, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" ToolTipService.ToolTip="Rename" AutomationProperties.Name="{x:Bind RenameName}"
                                                                    IsEnabled="{x:Bind CanEdit, Mode=OneWay}" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE8AC;" FontSize="14" />
                                                                <Button.Flyout>
                                                                    <Flyout Placement="Bottom">
                                                                        <StackPanel Spacing="8" MinWidth="260">
                                                                            <TextBlock Text="Steps that pick it keep working." Style="{StaticResource SettingsCardDescription}" />
                                                                            <TextBox Text="{x:Bind Name}" Header="Name" KeyDown="OnRenameInputKeyDown" Tag="{x:Bind}" />
                                                                            <TextBlock Text="{x:Bind RenameError, Mode=OneWay}" Visibility="{x:Bind HasRenameError, Mode=OneWay}"
                                                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                                            <Button Content="Rename" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                                                                                    Click="OnRenameInputSave" Tag="{x:Bind}" />
                                                                        </StackPanel>
                                                                    </Flyout>
                                                                </Button.Flyout>
                                                            </Button>
                                                            <!-- The tooltip sits on a wrapper because a disabled button shows none. -->
                                                            <Border Grid.Column="2" Background="Transparent" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind RemoveTip, Mode=OneWay}">
                                                                <Button Click="OnRemoveInput" Tag="{x:Bind}" IsEnabled="{x:Bind CanRemove, Mode=OneWay}"
                                                                        AutomationProperties.Name="{x:Bind RemoveName}" AutomationProperties.HelpText="{x:Bind RemoveTip, Mode=OneWay}">
                                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                                </Button>
                                                            </Border>
                                                            <!-- The moves in send order; × takes one out. Wraps in a narrow window. -->
                                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{x:Bind MovesText, Mode=OneWay}"
                                                                       Style="{StaticResource SettingsCardDescription}" Visibility="{x:Bind HasNoMoves, Mode=OneWay}" />
                                                            <ItemsRepeater Grid.Row="1" Grid.ColumnSpan="3" ItemsSource="{x:Bind Moves, Mode=OneWay}"
                                                                           AutomationProperties.Name="{x:Bind MovesName}">
                                                                <ItemsRepeater.Layout>
                                                                    <UniformGridLayout MinItemWidth="104" MinColumnSpacing="4" MinRowSpacing="4" ItemsStretch="Fill" />
                                                                </ItemsRepeater.Layout>
                                                                <ItemsRepeater.ItemTemplate>
                                                                    <DataTemplate x:DataType="vml:MoveToken">
                                                                        <Grid ColumnSpacing="6" Padding="8,2,2,2" CornerRadius="{StaticResource ControlCornerRadius}"
                                                                              Background="{ThemeResource ControlFillColorSecondaryBrush}" AutomationProperties.Name="{x:Bind Text}">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" VerticalAlignment="Center" />
                                                                            <Button Grid.Column="2" Tag="{x:Bind}" Click="OnRemoveMove" Padding="6" Background="Transparent" BorderThickness="0"
                                                                                    AutomationProperties.Name="{x:Bind RemoveName}" ToolTipService.ToolTip="Remove this move"
                                                                                    IsEnabled="{x:Bind Input.CanEdit, Mode=OneWay}">
                                                                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsRepeater.ItemTemplate>
                                                            </ItemsRepeater>
                                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="4">
                                                                <Button Click="OnAddUp" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                                        AutomationProperties.Name="{x:Bind AddUpName}" ToolTipService.ToolTip="Add a move up">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE70E;" FontSize="12" />
                                                                        <TextBlock Text="Add Up" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <Button Click="OnAddDown" Tag="{x:Bind}" IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                                        AutomationProperties.Name="{x:Bind AddDownName}" ToolTipService.ToolTip="Add a move down">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                                                                        <TextBlock Text="Add Down" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                            </ItemsRepeater>
                                            <Button IsEnabled="{x:Bind CanEditInputs, Mode=OneWay}" AutomationProperties.Name="Add input">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                                    <TextBlock Text="Add input" />
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <Flyout Placement="Bottom">
                                                        <StackPanel Spacing="8" MinWidth="260">
                                                            <TextBox Text="{x:Bind NewInputName, Mode=OneWay}" Header="Name" PlaceholderText="hdmi2"
                                                                     KeyDown="OnAddInputKeyDown" Tag="{x:Bind}" />
                                                            <TextBlock Text="{x:Bind AddInputError, Mode=OneWay}" Visibility="{x:Bind HasAddInputError, Mode=OneWay}"
                                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                                            <Button Content="Add" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Right"
                                                                    Click="OnAddInputSave" Tag="{x:Bind}" />
                                                        </StackPanel>
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <InfoBar Severity="Success" IsOpen="{x:Bind Worked, Mode=OneWay}" Message="{x:Bind ResultMessage, Mode=OneWay}"
                                             CloseButtonCommand="{x:Bind DismissResultCommand}" />
                                    <InfoBar Severity="Warning" IsOpen="{x:Bind Cautioned, Mode=OneWay}" Message="{x:Bind ResultMessage, Mode=OneWay}"
                                             CloseButtonCommand="{x:Bind DismissResultCommand}" />
                                    <InfoBar Severity="Error" IsOpen="{x:Bind Failed, Mode=OneWay}" Message="{x:Bind ResultMessage, Mode=OneWay}"
                                             CloseButtonCommand="{x:Bind DismissResultCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </DataTemplate>
        </Pivot.ItemTemplate>
    </Pivot>
</UserControl>
