<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DazeControl.Editor.Library.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vml="using:DazeControl.Editor.ViewModels.LibraryPage"
    xmlns:vmi="using:DazeControl.Editor.ViewModels.Inspector">

    <!-- Library (UX §5.1): a Pivot per kind; settings cards with live state, "Used by 2 flows" and Test. -->
    <Pivot x:Name="SectionsPivot" Margin="-12,0,-12,0" SelectionChanged="OnSectionChanged" AutomationProperties.Name="Library">
        <Pivot.HeaderTemplate>
            <DataTemplate x:DataType="vml:LibrarySectionViewModel">
                <TextBlock Text="{x:Bind Title}" />
            </DataTemplate>
        </Pivot.HeaderTemplate>
        <Pivot.ItemTemplate>
            <DataTemplate x:DataType="vml:LibrarySectionViewModel">
                <StackPanel Spacing="4" Margin="0,8,0,0">
                    <!-- Section commands -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Visibility="{x:Bind CanAdd}" IsEnabled="{x:Bind HasAvailable, Mode=OneWay}" AutomationProperties.Name="Add from Windows"
                                ToolTipService.ToolTip="Devices Windows sees that aren't in your Library yet">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                                <TextBlock Text="Add from Windows" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <ListView ItemsSource="{x:Bind Available, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True"
                                              ItemClick="OnAddClick" MinWidth="280" AutomationProperties.Name="Devices from Windows">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="vmi:DeviceOption">
                                                <Grid ColumnSpacing="10" Padding="0,6" AutomationProperties.Name="{x:Bind AutomationName}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{x:Bind Title}" />
                                                        <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SettingsCardDescription}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Visibility="{x:Bind CanCapture}" Click="OnCapture" AutomationProperties.Name="Capture current layout"
                                ToolTipService.ToolTip="Saves how your screens are set up now.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE722;" FontSize="14" />
                                <TextBlock Text="Capture current layout" />
                                <ProgressRing IsActive="{x:Bind IsCapturing, Mode=OneWay}" Width="14" Height="14" />
                            </StackPanel>
                        </Button>
                        <Button Click="OnRefresh" ToolTipService.ToolTip="Check what's connected now" AutomationProperties.Name="Refresh"
                                Visibility="{x:Bind CanAdd}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </StackPanel>
                    <InfoBar Severity="Warning" IsOpen="{x:Bind HasNote, Mode=OneWay}" IsClosable="False" Message="{x:Bind Note, Mode=OneWay}" />

                    <!-- Empty state -->
                    <StackPanel Visibility="{x:Bind IsEmpty, Mode=OneWay}" Spacing="8" Margin="0,40,0,0" HorizontalAlignment="Center">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind EmptyText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                                   Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>

                    <ItemsRepeater ItemsSource="{x:Bind Items}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="4" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vml:LibraryItemViewModel">
                                <StackPanel Spacing="0">
                                    <Grid Style="{StaticResource SettingsCard}" AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <!-- Fixed, so Test lines up whether or not Remove shows. -->
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" Style="{StaticResource SettingsCardIcon}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource SettingsCardDescription}" />
                                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind HasProblem, Mode=OneWay}">
                                                <FontIcon Glyph="&#xEA39;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                <TextBlock Text="{x:Bind Problem, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind UsedByText, Mode=OneWay}" VerticalAlignment="Center"
                                                   Style="{StaticResource SettingsCardDescription}" />
                                        <Button Grid.Column="3" Command="{x:Bind TestCommand}" IsEnabled="{x:Bind CanTest, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind TestName, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <ProgressRing IsActive="{x:Bind IsTesting, Mode=OneWay}" Width="14" Height="14"
                                                              Visibility="{x:Bind IsTesting, Mode=OneWay}" />
                                                <TextBlock Text="Test" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Click="OnRemove" HorizontalAlignment="Right" Tag="{x:Bind}" Visibility="{x:Bind CanRemove, Mode=OneWay}"
                                                ToolTipService.ToolTip="Remove from Library" AutomationProperties.Name="{x:Bind RemoveName, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <InfoBar Severity="Success" IsOpen="{x:Bind Worked, Mode=OneWay}" Message="{x:Bind ResultMessage, Mode=OneWay}"
                                             CloseButtonCommand="{x:Bind DismissResultCommand}" />
                                    <InfoBar Severity="Warning" IsOpen="{x:Bind Cautioned, Mode=OneWay}" Message="{x:Bind ResultMessage, Mode=OneWay}"
                                             CloseButtonCommand="{x:Bind DismissResultCommand}" />
                                    <InfoBar Severity="Error" IsOpen="{x:Bind Failed, Mode=OneWay}" Message="{x:Bind ResultMessage, Mode=OneWay}"
                                             CloseButtonCommand="{x:Bind DismissResultCommand}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </DataTemplate>
        </Pivot.ItemTemplate>
    </Pivot>
</UserControl>
