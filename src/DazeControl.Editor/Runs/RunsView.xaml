<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DazeControl.Editor.Runs.RunsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DazeControl.Editor.Runs"
    xmlns:vmr="using:DazeControl.Editor.ViewModels.Runs">

    <UserControl.Resources>
        <!-- A timeline bar: a focusable, invokable button whose look is drawn in code. -->
        <Style x:Key="TimelineBarStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FocusVisualMargin" Value="-3" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Runs (UX §5.5): the last 100 runs by day on the left, the picked one's result and timeline on the right. -->
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="RunsList" SelectionMode="Single" IsSynchronizedWithCurrentItem="False" AutomationProperties.Name="Runs"
                  Margin="-12,0,0,0" SelectionChanged="OnRunSelected">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vmr:RunDay">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vmr:RunItemViewModel">
                    <Grid ColumnSpacing="12" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Caption}" Style="{StaticResource SettingsCardDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                                Background="{x:Bind local:RunsView.ChipBackground(Outcome)}"
                                BorderBrush="{x:Bind local:RunsView.ChipStroke(Outcome)}" BorderThickness="1">
                            <TextBlock Text="{x:Bind Result}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyState" Grid.ColumnSpan="2" Spacing="8" Margin="0,48,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
            <FontIcon Glyph="&#xE81C;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="No runs yet" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="Run a flow and it shows up here." HorizontalAlignment="Center" Style="{StaticResource SettingsCardDescription}" />
        </StackPanel>

        <StackPanel x:Name="NoSelectionText" Grid.Column="1" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE81C;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Pick a run to see how it went." HorizontalAlignment="Center" Style="{StaticResource SettingsCardDescription}" />
        </StackPanel>

        <ScrollViewer x:Name="DetailScroller" Grid.Column="1" Visibility="Collapsed">
            <StackPanel Spacing="12" Padding="0,0,16,16">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="DetailName" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailFacts" Style="{StaticResource SettingsCardDescription}" />
                    </StackPanel>
                    <Button x:Name="OpenInEditorButton" Grid.Column="1" AutomationProperties.Name="Open in editor" VerticalAlignment="Top" Click="OnOpenInEditor"
                            ToolTipService.ToolTip="Show this run on the flow's canvas">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="Open in editor" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock x:Name="DetailSentence" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />

                <TextBlock x:Name="NoTimelineText" Text="This run is from an older version, so it has no timeline."
                           Style="{StaticResource SettingsCardDescription}" Visibility="Collapsed" />
                <!-- Timeline (UX §5.5): drawn in code from the detail's Bars / Brackets / Ticks. -->
                <Border x:Name="TimelineHost" Padding="12" CornerRadius="8" BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" SizeChanged="OnTimelineSizeChanged">
                    <Canvas x:Name="TimelineCanvas" AutomationProperties.Name="Timeline" />
                </Border>

                <StackPanel x:Name="SelectedPanel" Spacing="2" Visibility="Collapsed">
                    <ItemsControl x:Name="SelectedLinesList" AutomationProperties.Name="What happened to this step">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="13" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBlock x:Name="PickBarText" Text="Pick a bar to see what happened to that step." Style="{StaticResource SettingsCardDescription}" />

                <StackPanel x:Name="NotRunPanel" Spacing="2" Visibility="Collapsed">
                    <TextBlock Text="Didn't run" Style="{StaticResource SettingsSection}" Margin="0,8,0,4" />
                    <ItemsControl x:Name="NotRunList" AutomationProperties.Name="Steps that didn't run">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
